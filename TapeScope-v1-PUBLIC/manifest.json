{
  "manifest_version": 3,
  "name": "TapeScope",
  "version": "0.9.1",
  "description": "Read-only raw Vest Markets OHLC chart and print tape.",
  "host_permissions": [
    "https://api-gateway.hz.vestmarkets.com/*",
    "https://server-prod.hz.vestmarkets.com/*",
    "wss://ws.hz.vestmarkets.com/*"
  ],
  "action": {
    "default_title": "Open TapeScope"
  },
  "background": {
    "service_worker": "background.js"
  }
}
